# Môi trường thử (staging) của hồ sơ "Vận hành" (DT-SaaS phần S7a, YCTD-198): cùng compose.yml, tên dự án khác (vùng chứa,
# ổ dữ liệu, cơ sở dữ liệu tách hẳn môi trường chạy thật), tên miền *.staging.<tên miền hệ thống>, CHỈ DỮ LIỆU GIẢ (hồ sơ demo
# tạo và đặt lại dữ liệu giả). Sao chép thành staging.env; các khóa, mật khẩu sinh riêng, không dùng lại của môi trường chạy
# thật. Chỉ ghi các giá trị khác production.env.example; giá trị dưới đây là giả.
COMPOSE_PROJECT_NAME=school-staging
# Cùng VPS với môi trường chạy thật: không chạy giám sát riêng (dùng chung), Caddy staging nằm sau Caddy chính
COMPOSE_PROFILES=db,app,seaweedfs,demo
ENVIRONMENT_NAME=staging
HOST_LABEL=vps-1
IMAGE_PREFIX=school-management
IMAGE_TAG=latest
# Mã OTP, tin nhắn chỉ ghi nhật ký
NODE_ENV=staging
SMS_PROVIDER=log
TRUST_PROXY=uniquelocal

ACME_EMAIL=van-hanh@he-thong.test
DOMAIN_CHECK_URL=http://api-a:3000/api/v1/public/website/domain-check
# Sau Caddy chính: chỉ HTTP trong mạng school-edge, không cấp chứng chỉ, không mở cổng (HTTP_BIND, HTTPS_BIND ở cổng nội bộ)
CATCH_ALL_ADDRESS=http://
TLS_MODE=off
TENANT_PATHS=off
EDGE_ALIAS=staging-web
HTTP_BIND=127.0.0.1:8080
HTTPS_BIND=127.0.0.1:8443

# Cơ sở dữ liệu riêng của dự án staging (ổ dữ liệu school-staging_postgres-data); cổng chỉ trong mạng nội bộ
DB_BIND_ADDRESS=127.0.0.1
POSTGRES_PUBLISH_PORT=15432
PGBOUNCER_PUBLISH_PORT=16432
DATABASE_HOST=pgbouncer
DATABASE_PORT=6432
MIGRATE_DATABASE_HOST=postgres
MIGRATE_DATABASE_PORT=5432
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
POSTGRES_PASSWORD=
IDENTITY_DATABASE_PASSWORD=
API_DATABASE_PASSWORD=
REDIS_PASSWORD=
IDENTITY_TOKEN_PRIVATE_KEY=
TOKEN_PUBLIC_KEY=
CHILD_DATA_ENCRYPTION_KEY=
CHILD_DATA_HASH_KEY=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DEMO_RESET_INTERVAL_HOURS=24
GRAFANA_ADMIN_PASSWORD=khong-dung-o-staging
