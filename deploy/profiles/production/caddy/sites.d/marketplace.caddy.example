# Chợ gia sư (DT-27 phần 27f, YCTD-256; ứng dụng Gia sư YCTD-262): hai ứng dụng tĩnh trên tên miền con dành riêng của nền tảng, /api/v1
# chuyển về máy chủ như mọi tên miền khác. Bật bằng cách sao chép thành marketplace.caddy và đặt MARKET_SITE, TUTOR_SITE trong
# production.env; hai tên miền phải trùng với tên miền đặt ở cổng nền tảng (trang Chợ gia sư), không thì máy chủ API trả 404.
# Máy chủ API cần MARKETPLACE_DATABASE_URL (vai trò riêng của chợ, xem database/src/marketplace/marketplace-database.ts)

# Ứng dụng phụ huynh của chợ (apps/market)
{$MARKET_SITE} {
	import common
	import backend
	import spa /srv/market
}

# Ứng dụng Gia sư (apps/tutor)
{$TUTOR_SITE} {
	import common
	import backend
	import spa /srv/tutor
}
