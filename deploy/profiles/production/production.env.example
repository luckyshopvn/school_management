# Cấu hình hồ sơ "Vận hành" (b) trên VPS trong nước (DT-SaaS phần S7a, YCTD-198). Sao chép thành production.env ở thư mục
# này, điền giá trị, chmod 600. Không đưa production.env lên kho mã (đã có .gitignore). Mọi giá trị dưới đây là GIẢ: tên miền
# dạng *.test, mật khẩu và khóa để trống. Sinh mật khẩu, khóa bằng: sh ../../scripts/generate-keys.sh production.env
# Mật khẩu chỉ dùng chữ và số vì được ghép vào chuỗi kết nối.

# ---------------------------------------------------------------------------------------------------------------------
# Chung
# ---------------------------------------------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=school-production
# T1 một VPS: db,app,seaweedfs,monitoring. T2, T3: xem đầu compose.yml
COMPOSE_PROFILES=db,app,seaweedfs,monitoring
IMAGE_PREFIX=school-management
# Đổi theo phiên bản phát hành (ví dụ 1.4.0) để quay lui được về ảnh trước; scripts/deploy.sh nhận phiên bản ở tham số
IMAGE_TAG=latest
NODE_ENV=production
TRUST_PROXY=uniquelocal
# Tên môi trường và tên máy ghi trên cảnh báo, nhật ký
ENVIRONMENT_NAME=production
HOST_LABEL=vps-1

# ---------------------------------------------------------------------------------------------------------------------
# Tên miền, HTTPS (Caddy)
# ---------------------------------------------------------------------------------------------------------------------
ACME_EMAIL=van-hanh@he-thong.test
# Điểm cuối Caddy hỏi trước khi xin chứng chỉ cho một tên miền lạ; trả 200 thì mới cấp. Hiện là danh sách tên miền website
# của trường (YCTD-144); khi có cơ sở dữ liệu nền tảng (DT-SaaS S1b) đổi sang điểm cuối kiểm tra tên miền của nền tảng
DOMAIN_CHECK_URL=http://api-a:3000/api/v1/public/website/domain-check
# Khối bắt chung nhận mọi tên miền: https:// kèm cấp chứng chỉ theo yêu cầu
CATCH_ALL_ADDRESS=https://
TLS_MODE=on-demand
# on: mở /quan-ly, /giao-vien, /phu-huynh, /api/v1 trên tên miền của từng trường (chỉ bật sau DT-SaaS S1b)
TENANT_PATHS=off
# Bản một trường: bật caddy/sites.d/single-school.caddy và ghi bốn tên miền (bỏ trống nếu không dùng)
PORTAL_SITE=
PARENT_SITE=
TEACHER_SITE=
API_SITE=
# Môi trường thử cùng VPS: bật caddy/sites.d/staging-proxy.caddy và ghi tên miền thử, cách nhau bằng dấu phẩy
STAGING_SITES=
HTTP_BIND=80
HTTPS_BIND=443

# ---------------------------------------------------------------------------------------------------------------------
# PostgreSQL, PgBouncer
# ---------------------------------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=
IDENTITY_DATABASE_PASSWORD=
API_DATABASE_PASSWORD=
# T1: 127.0.0.1. T2, T3 ở máy cơ sở dữ liệu: địa chỉ mạng riêng giữa các VPS (không dùng địa chỉ công khai)
DB_BIND_ADDRESS=127.0.0.1
# Máy ứng dụng nối PgBouncer (T1: pgbouncer; T2, T3: địa chỉ riêng của máy cơ sở dữ liệu) và migrate nối thẳng PostgreSQL
DATABASE_HOST=pgbouncer
DATABASE_PORT=6432
MIGRATE_DATABASE_HOST=postgres
MIGRATE_DATABASE_PORT=5432
# Gợi ý cho máy 8 GB chạy riêng cơ sở dữ liệu; T1 máy 8 GB dùng 512MB và 2GB
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_MAX_LOCKS_PER_TRANSACTION=256
POSTGRES_AUTOVACUUM_MAX_WORKERS=4
POSTGRES_AUTOVACUUM_NAPTIME=30s
POSTGRES_WAL_KEEP_SIZE=1GB
POSTGRES_LOG_MIN_DURATION_MS=1000
# PgBouncer: số kết nối thật tới mỗi cặp cơ sở dữ liệu, tài khoản và tối đa mỗi cơ sở dữ liệu
PGBOUNCER_DEFAULT_POOL_SIZE=10
PGBOUNCER_MAX_DB_CONNECTIONS=40
PGBOUNCER_MAX_CLIENT_CONN=2000
PGBOUNCER_SESSION_DATABASES=school_system
PGBOUNCER_STATS_PASSWORD=
# Bản sao (T3): mật khẩu vai trò sao chép, dải địa chỉ mạng riêng được nối, máy chính (ở máy bản sao)
REPLICATION_PASSWORD=
REPLICATION_ALLOWED_CIDR=10.0.0.0/8
PRIMARY_DATABASE_HOST=
PRIMARY_DATABASE_PORT=5432
REPLICATION_SLOT=replica_1
# Khôi phục về một thời điểm (DT-SaaS S7b, compose.pitr.yml, PITR.md): kho ngoài máy chủ tương thích S3 cho nhật ký giao dịch và
# bản cơ bản; khóa mã hóa 32 byte (openssl rand -base64 32). Mọi giá trị dưới đây là giả
WALG_S3_PREFIX=s3://kho-gia/school-wal
WALG_S3_ENDPOINT=https://s3.kho-ngoai.example.test
WALG_S3_REGION=us-east-1
WALG_S3_ACCESS_KEY_ID=
WALG_S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------------------------------------------------
# Giám thị camera cho thi trực tuyến (DT-23 phần 23e, YCTD-215): máy chủ chuyển tiếp WebRTC coturn (tuỳ chọn)
# Để trống là chỉ kết nối trực tiếp được khi giáo viên và học sinh cùng mạng. Bật coturn: thêm `coturn` vào COMPOSE_PROFILES,
# đặt TURN_EXTERNAL_IP là địa chỉ IP công khai của máy chủ, mở cổng UDP và TCP 3478 và dải UDP 49160 đến 49200 ở tường lửa;
# TURN_URLS ví dụ turn:turn.<tên miền>:3478?transport=udp,turn:turn.<tên miền>:3478?transport=tcp; STUN_URLS ví dụ
# stun:turn.<tên miền>:3478. TURN_SHARED_SECRET sinh bằng deploy/scripts/generate-keys.sh; máy chủ API chỉ cấp cho trình duyệt
# tên đăng nhập có hạn (TURN_TTL_SECONDS) tính từ khoá này
# ---------------------------------------------------------------------------------------------------------------------
STUN_URLS=
TURN_URLS=
TURN_SHARED_SECRET=
TURN_EXTERNAL_IP=
TURN_REALM=school.local
TURN_TTL_SECONDS=14400

# ---------------------------------------------------------------------------------------------------------------------
# Lớp video trực tiếp (DT-27 phần 27a, YCTD-251): LiveKit tự host và Egress ghi hình (tuỳ chọn)
# Để trống VIDEO_PROVIDER là tắt video. Bật: thêm `video` (và `coturn`) vào COMPOSE_PROFILES, đặt VIDEO_PROVIDER=livekit,
# LIVEKIT_PUBLIC_URL là địa chỉ wss trình duyệt nối tới (ví dụ wss://video.<tên miền>, bộ chuyển tiếp chuyển về cổng 7880),
# LIVEKIT_WEBHOOK_URL là địa chỉ máy chủ API nhận sự kiện (ví dụ http://api:3000/api/v1/video/webhook), TURN_HOST là tên miền
# của coturn; mở cổng TCP 7881 và dải UDP 50000 đến 50200. LIVEKIT_API_SECRET sinh bằng deploy/scripts/generate-keys.sh.
# Dự phòng LiveKit Cloud: VIDEO_PROVIDER=livekit-cloud, LIVEKIT_URL là địa chỉ dự án https://…livekit.cloud
# ---------------------------------------------------------------------------------------------------------------------
VIDEO_PROVIDER=
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=school-video
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_URL=
TURN_HOST=
WALG_LIBSODIUM_KEY=
POSTGRES_ARCHIVE_TIMEOUT=60

# ---------------------------------------------------------------------------------------------------------------------
# Redis, khóa, kho tệp (như deploy/.env.production.example)
# ---------------------------------------------------------------------------------------------------------------------
REDIS_PASSWORD=
# Máy Redis (T3: địa chỉ riêng của máy ứng dụng thứ nhất để hai máy dùng chung)
REDIS_HOST=redis
IDENTITY_TOKEN_PRIVATE_KEY=
TOKEN_PUBLIC_KEY=
CHILD_DATA_ENCRYPTION_KEY=
CHILD_DATA_HASH_KEY=
S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=school-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------------------------------------------------
# Dịch vụ ngoài (để trống là chưa bật; ý nghĩa như deploy/.env.production.example)
# ---------------------------------------------------------------------------------------------------------------------
LOGIN_REQUESTS_PER_MINUTE=10
SMS_PROVIDER=esms
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
ESMS_SANDBOX=
ESMS_UNICODE=
PAYMENT_GATEWAY=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
SEPAY_WEBHOOK_API_KEY=
CASSO_WEBHOOK_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
VNPAY_PAYMENT_URL=
NOTIFICATION_DISPATCH_INTERVAL_SECONDS=60
EXPORT_JOB_INTERVAL_SECONDS=15
FACEBOOK_PUBLISHER=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v21.0
ZALO_SENDER=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_REFRESH_TOKEN=
ZALO_OA_ACCESS_TOKEN=

# ---------------------------------------------------------------------------------------------------------------------
# Giám sát, cảnh báo (chạy trên chính VPS)
# ---------------------------------------------------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=
GRAFANA_BIND_PORT=3300
PROMETHEUS_RETENTION=30d
# T2, T3: máy chỉ chạy bộ thu số liệu mở cổng 9100, 9187 trên địa chỉ mạng riêng để máy giám sát đọc
MONITORING_AGENT_BIND=127.0.0.1
POSTGRES_EXPORTER_HOST=postgres
# Kênh cảnh báo; kênh nào để trống thì không gửi. Zalo: địa chỉ webhook của dịch vụ chuyển tiếp sang Zalo OA
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_EMAIL_SMARTHOST=
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------------------------------------------------
# Sao lưu (deploy/scripts/backup.sh như bản một máy; chạy với COMPOSE_FILE, ENV_FILE của hồ sơ này, xem README). Bản sao
# lưu ngoài máy chủ cũng phải ở trong nước (Nghị định 53/2022/NĐ-CP): kho S3 của nhà cung cấp khác hoặc vùng khác tại Việt
# Nam. Sao lưu theo từng trường, khôi phục về một thời điểm làm ở DT-SaaS S7b
# ---------------------------------------------------------------------------------------------------------------------
BACKUP_DIR=/var/backups/school-production
BACKUP_RETENTION_DAYS=30
BACKUP_HOURLY_RETENTION_HOURS=48
BACKUP_ENCRYPTION_PASSPHRASE=
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=us-east-1
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
OFFSITE_S3_PREFIX=school-production
BACKUP_HEALTHCHECK_URL=
