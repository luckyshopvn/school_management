# Biến môi trường của máy chủ gộp, hồ sơ thử nghiệm (DT-SaaS phần S9, YCTD-203). Mọi giá trị ở đây là giả: chép thành tệp ngoài
# kho mã nguồn hoặc nhập vào bảng biến môi trường của Render, Koyeb; không đưa khóa thật lên kho. Biến riêng của từng tổ hợp nằm ở
# to-hop-*/env.to-hop-*.example (ghi đè các dòng dưới).

# --- Nền tảng nhiều trường (S1a) ---
NODE_ENV=production
PLATFORM_DATABASE_URL=postgres://chu_nen_tang:mat-khau-gia@may-chu-gom.example.test:5432/school_platform?sslmode=require
# 32 byte base64: node database/dist/src/platform-command.js generate-master-key (chỉ đặt ở máy chủ ứng dụng, không lưu cùng
# nhà cung cấp cơ sở dữ liệu, tài liệu 47 mục 14.5 S9 biện pháp 4)
PLATFORM_MASTER_KEY=QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE=
# Tài khoản tạo lược đồ, vai trò của trường (địa chỉ trực tiếp hoặc qua bộ gom, xem tổ hợp)
PLATFORM_ADMIN_DATABASE_URL=postgres://chu_nen_tang:mat-khau-gia@may-chu.example.test:5432/school_shared?sslmode=require
TENANT_DB_LAYOUT=schema
PLATFORM_SHARED_DATABASE=school_shared
# plain | neon | supabase (tài liệu 47 mục 14.4)
DB_HOST_ADAPTER=plain
TENANT_POOL_MAX=1
TENANT_POOL_SCHOOLS=4
TENANT_CACHE_SECONDS=30

# --- Tên miền, cổng biên ---
PLATFORM_ROOT_DOMAIN=thu.example.test
PLATFORM_CONSOLE_HOST=platform.thu.example.test
PLATFORM_INGRESS_HOST=vao.thu.example.test
# Cổng biên đặt tên miền gốc vào tiêu đề này kèm x-edge-auth; máy chủ có địa chỉ công khai nên thiếu bí mật thì không nhận trường
TENANT_HOST_SOURCE=header:x-school-host
EDGE_SHARED_SECRET=bi-mat-cong-bien-gia-thay-bang-chuoi-ngau-nhien
# Cloudflare Worker -> Render -> bộ định tuyến trong container: tin hai chặng để lấy đúng địa chỉ người dùng
TRUST_PROXY=2

# --- Tên miền riêng của trường (S2, S9): dns-check | cloudflare-saas | vercel-domains ---
DOMAIN_PROVIDER=cloudflare-saas
CLOUDFLARE_API_TOKEN=khoa-cloudflare-gia
CLOUDFLARE_ZONE_ID=vung-cloudflare-gia
# VERCEL_TOKEN=khoa-vercel-gia
# VERCEL_PROJECT_ID=du-an-vercel-gia
# VERCEL_TEAM_ID=

# --- Chính sách dữ liệu (S9): any | consent-required | synthetic-only ---
PLATFORM_DATA_POLICY=consent-required
SCHOOL_DELETION_GRACE_DAYS=30

# --- Việc định kỳ: Cloudflare Cron Triggers (hoặc GitHub Actions) gọi tick ---
SCHEDULER_MODE=external
INTERNAL_JOB_TOKEN=ma-tick-gia-thay-bang-chuoi-ngau-nhien

# --- Khởi động ---
MIGRATE_ON_START=true
MIGRATE_SCHOOLS_ON_START=false
NODE_OPTIONS=--max-old-space-size=384

# --- Không Redis: dịch vụ định danh dùng kho trong bộ nhớ (một bản container) ---
REDIS_URL=memory://

# --- Khóa ký mã phiên (node apps/identity/dist/generate-token-keys.js) ---
IDENTITY_TOKEN_PRIVATE_KEY=khoa-rieng-gia-base64
TOKEN_PUBLIC_KEY=khoa-cong-khai-gia-base64

# --- Kho tệp tương thích S3 (R2 hoặc Supabase Storage, xem tổ hợp) ---
S3_ENDPOINT=https://ma-tai-khoan-gia.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=school-files
S3_ACCESS_KEY_ID=khoa-truy-cap-gia
S3_SECRET_ACCESS_KEY=khoa-bi-mat-gia

# --- Tin nhắn, thanh toán: giả lập ở hồ sơ thử nghiệm (cấu hình riêng từng trường làm ở S3, YCTD-195) ---
SMS_PROVIDER=log
# Cho phép ghi mã một lần ra nhật ký khi NODE_ENV=production (chỉ trường dữ liệu giả); trường dữ liệu thật đặt SMS_PROVIDER=esms
SMS_ALLOW_LOG=true
PAYMENT_GATEWAY=development
FACEBOOK_PUBLISHER=development
ZALO_SENDER=development
LOGIN_REQUESTS_PER_MINUTE=10
