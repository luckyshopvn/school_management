# Tổ hợp 2: Cloudflare Worker, Supabase, Koyeb (DT-SaaS phần S9). Ghi đè env.trial.example; mọi giá trị là giả
DB_HOST_ADAPTER=supabase
SUPABASE_PROJECT_REF=abcdefghgia
# Máy chủ bộ gom dùng chung chép ở hộp Connect của Supabase (cổng 6543, chế độ theo giao dịch)
DB_POOLER_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_POOLER_PORT=6543
PLATFORM_DATABASE_URL=postgres://postgres.abcdefghgia:mat-khau-gia@aws-0-ap-southeast-1.pooler.supabase.com:6543/school_platform
PLATFORM_ADMIN_DATABASE_URL=postgres://postgres.abcdefghgia:mat-khau-gia@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
PLATFORM_SHARED_DATABASE=postgres
S3_ENDPOINT=https://abcdefghgia.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=school-files
DOMAIN_PROVIDER=cloudflare-saas
