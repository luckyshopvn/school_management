# Cấu hình môi trường chạy thật (YCTD-92). Sao chép thành deploy/.env trên máy chủ, điền giá trị, đặt quyền chmod 600.
# Không đưa deploy/.env lên kho mã nguồn (QU-05). Sinh mật khẩu và khóa bằng: sh deploy/scripts/generate-keys.sh
# Mật khẩu chỉ dùng chữ và số (generate-keys.sh sinh dạng hex) vì được ghép vào chuỗi kết nối postgres://... và redis://...

# ---------------------------------------------------------------------------------------------------------------------
# Chung
# ---------------------------------------------------------------------------------------------------------------------
# Tên dự án Docker Compose (tiền tố tên vùng chứa và ổ dữ liệu); giữ nguyên sau lần triển khai đầu
COMPOSE_PROJECT_NAME=school-management
# `seaweedfs` là chạy kho tệp S3 trên cùng máy; để trống khi dùng kho đối tượng của nhà cung cấp đám mây (xem mục Kho tệp)
COMPOSE_PROFILES=seaweedfs
# Tên ảnh khi dựng trên máy chủ; đổi IMAGE_TAG theo phiên bản phát hành (ví dụ 1.2.0) để quay lui được về ảnh trước
IMAGE_PREFIX=school-management
IMAGE_TAG=latest
# `production` ở môi trường chạy thật. Dịch vụ định danh và máy chủ API từ chối khởi động với NODE_ENV=production khi
# chưa đặt SMS_PROVIDER=esms (YCTD-43, YCTD-93). Môi trường thử nghiệm chưa có tài khoản eSMS đặt `staging`: mã OTP và tin
# nhắn chỉ ghi ra nhật ký, không gửi
NODE_ENV=production

# ---------------------------------------------------------------------------------------------------------------------
# Tên miền và HTTPS (Caddy tự xin chứng chỉ Let's Encrypt; bản ghi DNS phải trỏ về máy chủ trước khi chạy)
# ---------------------------------------------------------------------------------------------------------------------
# Thư điện tử nhận thông báo hết hạn chứng chỉ
ACME_EMAIL=quantri@ten-mien-truong.vn
# Trang quản lý cho cán bộ, ứng dụng phụ huynh, ứng dụng giáo viên, địa chỉ cho đối tác và cổng thanh toán gọi về.
# Ghi tên miền không kèm https://. Thử trên máy cục bộ không có chứng chỉ thì ghi dạng http://portal.localhost
PORTAL_SITE=portal.ten-mien-truong.vn
PARENT_SITE=phuhuynh.ten-mien-truong.vn
TEACHER_SITE=giaovien.ten-mien-truong.vn
API_SITE=api.ten-mien-truong.vn
# Cổng mở ra ngoài của Caddy
HTTP_PORT=80
HTTPS_PORT=443
# Caddy ở mạng nội bộ của Docker; hai dịch vụ tin tiêu đề X-Forwarded-For từ địa chỉ nội bộ để lấy đúng địa chỉ người dùng
TRUST_PROXY=uniquelocal

# ---------------------------------------------------------------------------------------------------------------------
# PostgreSQL 17 (không mở cổng ra ngoài)
# ---------------------------------------------------------------------------------------------------------------------
# Mật khẩu tài khoản quản trị postgres; chỉ dùng cho sao lưu, khôi phục và bảo trì
POSTGRES_PASSWORD=
# Mật khẩu tài khoản kết nối của dịch vụ định danh (cơ sở dữ liệu school_identity)
IDENTITY_DATABASE_PASSWORD=
# Mật khẩu tài khoản kết nối của máy chủ API (school_system và các cơ sở dữ liệu năm học school_year_*; có quyền CREATEDB, QĐ-21)
API_DATABASE_PASSWORD=
# Tinh chỉnh theo bộ nhớ máy chủ (gợi ý cho máy 8 GB; máy 4 GB dùng 256MB và 1GB)
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
# Ghi nhật ký câu lệnh chạy lâu hơn số mili giây này (theo dõi hiệu năng)
POSTGRES_LOG_MIN_DURATION_MS=1000

# ---------------------------------------------------------------------------------------------------------------------
# Redis (không mở cổng ra ngoài; bật appendonly để giữ giới hạn đăng nhập và mã OTP khi khởi động lại)
# ---------------------------------------------------------------------------------------------------------------------
REDIS_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------------
# Khóa ký mã phiên Ed25519 (QĐ-22): khóa bí mật chỉ ở dịch vụ định danh, khóa công khai ở cả hai dịch vụ.
# Giá trị là tệp PEM mã hóa base64 trên một dòng. Đổi khóa thì mọi phiên đăng nhập hết hiệu lực
# ---------------------------------------------------------------------------------------------------------------------
IDENTITY_TOKEN_PRIVATE_KEY=
TOKEN_PUBLIC_KEY=

# ---------------------------------------------------------------------------------------------------------------------
# Khóa mã hóa và khóa băm số định danh của trẻ, mỗi khóa 32 byte base64 (BM-64).
# BẮT BUỘC sao lưu riêng hai khóa này cùng nơi cất bản sao lưu; mất khóa thì không giải mã được dữ liệu đã lưu
# ---------------------------------------------------------------------------------------------------------------------
CHILD_DATA_ENCRYPTION_KEY=
CHILD_DATA_HASH_KEY=

# ---------------------------------------------------------------------------------------------------------------------
# Kho tệp tương thích S3 (ảnh, giấy tờ, chứng từ; YCTD-45)
# Mặc định: SeaweedFS chạy cùng máy (COMPOSE_PROFILES=seaweedfs), máy chủ API gọi http://seaweedfs:8333.
# Dùng kho đối tượng của nhà cung cấp đám mây trong nước: để trống COMPOSE_PROFILES, đặt S3_ENDPOINT là địa chỉ của nhà
# cung cấp (ví dụ https://s3.<vung>.<nha-cung-cap>.vn), S3_REGION theo nhà cung cấp, khóa truy cập do nhà cung cấp cấp;
# máy chủ API dùng kiểu đường dẫn (path-style) nên nhà cung cấp phải hỗ trợ kiểu này
# ---------------------------------------------------------------------------------------------------------------------
S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=school-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------------------------------------------------
# Giám thị camera cho thi trực tuyến (DT-23 phần 23e, YCTD-215): máy chủ chuyển tiếp WebRTC coturn (tuỳ chọn)
# Để trống là chỉ kết nối trực tiếp được khi giáo viên và học sinh cùng mạng. Bật coturn: thêm `coturn` vào COMPOSE_PROFILES,
# đặt TURN_EXTERNAL_IP là địa chỉ IP công khai của máy chủ, mở cổng UDP và TCP 3478 và dải UDP 49160 đến 49200 ở tường lửa;
# TURN_URLS ví dụ turn:turn.<tên miền>:3478?transport=udp,turn:turn.<tên miền>:3478?transport=tcp; STUN_URLS ví dụ
# stun:turn.<tên miền>:3478. TURN_SHARED_SECRET sinh bằng deploy/scripts/generate-keys.sh; máy chủ API chỉ cấp cho trình duyệt
# tên đăng nhập có hạn (TURN_TTL_SECONDS) tính từ khoá này
# ---------------------------------------------------------------------------------------------------------------------
STUN_URLS=
TURN_URLS=
TURN_SHARED_SECRET=
TURN_EXTERNAL_IP=
TURN_REALM=school.local
TURN_TTL_SECONDS=14400

# ---------------------------------------------------------------------------------------------------------------------
# Dịch vụ định danh
# ---------------------------------------------------------------------------------------------------------------------
# Số yêu cầu đăng nhập tối đa mỗi phút từ một địa chỉ
LOGIN_REQUESTS_PER_MINUTE=10
# Nhà cung cấp tin nhắn (mã đăng nhập phụ huynh và thông báo), dùng chung cho dịch vụ định danh và máy chủ API (YCTD-93):
# `esms` là eSMS.vn, bắt buộc ESMS_API_KEY, ESMS_SECRET_KEY, ESMS_BRANDNAME (tên thương hiệu đã đăng ký); `log` chỉ ghi
# nhật ký, không dùng được khi NODE_ENV=production. ESMS_SANDBOX=true gửi thử không ra tin thật (nên thử trước);
# ESMS_UNICODE=true gửi tin có dấu (giá cao hơn)
SMS_PROVIDER=esms
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
ESMS_SANDBOX=
ESMS_UNICODE=

# ---------------------------------------------------------------------------------------------------------------------
# Máy chủ API nghiệp vụ
# ---------------------------------------------------------------------------------------------------------------------
# Cổng thanh toán trực tuyến, các mã cách nhau bằng dấu phẩy, mã đầu là mặc định: `vietqr-static` là mã VietQR tĩnh đối soát
# qua sao kê (YCTD-89); `development` là bộ giả lập, KHÔNG dùng ở môi trường chạy thật. Để trống là chưa bật.
# `payos`, `sepay`, `casso`, `vnpay` là nhà cung cấp thật (YCTD-94); cổng đã bật mà thiếu biến dưới đây thì máy chủ API
# không khởi động. Địa chỉ báo tiền vào khai với nhà cung cấp: https://api.<tên miền>/api/v1/payment-webhooks/{payos,sepay,
# casso} và GET .../payment-webhooks/vnpay-ipn
PAYMENT_GATEWAY=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
SEPAY_WEBHOOK_API_KEY=
CASSO_WEBHOOK_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
# Địa chỉ thanh toán VNPay chính thức do VNPay cấp; trống là địa chỉ sandbox
VNPAY_PAYMENT_URL=
# Chu kỳ gửi thông báo và nhắc nhật ký, giây (CB-05, CB-07); 0 là tắt
NOTIFICATION_DISPATCH_INTERVAL_SECONDS=60
# Đăng Fanpage và gửi Zalo Official Account (YCTD-90, YCTD-95): `development` là bộ giả lập, KHÔNG dùng ở môi trường chạy
# thật; để trống là chưa đăng, chưa gửi. Fanpage thật: FACEBOOK_PUBLISHER=graph kèm khóa trang dài hạn. Zalo thật:
# ZALO_SENDER=zalo_oa kèm ZALO_APP_ID, ZALO_APP_SECRET, ZALO_OA_REFRESH_TOKEN; máy chủ tự làm mới khóa và lưu khóa mới (mã
# hóa) ở cơ sở dữ liệu hệ thống, khóa làm mới hết hạn thì dán khóa mới ở màn hình Kết nối ngoài
FACEBOOK_PUBLISHER=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v21.0
ZALO_SENDER=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_REFRESH_TOKEN=
ZALO_OA_ACCESS_TOKEN=

# ---------------------------------------------------------------------------------------------------------------------
# Sao lưu (deploy/scripts/backup.sh; SL-01 đến SL-05)
# ---------------------------------------------------------------------------------------------------------------------
# Thư mục chứa bản sao lưu trên máy chủ
BACKUP_DIR=/var/backups/school-management
# Số ngày giữ bản sao lưu hằng ngày (SL-01: tối thiểu 30) và số giờ giữ bản sao lưu hằng giờ
BACKUP_RETENTION_DAYS=30
BACKUP_HOURLY_RETENTION_HOURS=48
# Mật khẩu mã hóa bản sao lưu (AES-256, SL-05). Cất bản sao mật khẩu ở nơi khác máy chủ; mất mật khẩu thì không khôi phục được
BACKUP_ENCRYPTION_PASSPHRASE=
# Nơi cất bản sao lưu ngoài máy chủ (SL-05), kho S3 của nhà cung cấp khác hoặc vùng khác. Để trống OFFSITE_S3_BUCKET là
# không đẩy đi (chỉ dùng khi thử; môi trường chạy thật bắt buộc có)
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=us-east-1
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
# Thư mục con trong kho ngoài máy chủ
OFFSITE_S3_PREFIX=school-management
# Địa chỉ gọi khi sao lưu xong (ví dụ healthchecks.io) để được cảnh báo khi sao lưu không chạy; để trống là không gọi
BACKUP_HEALTHCHECK_URL=
