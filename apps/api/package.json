{
  "name": "@school-management/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "generate-data-keys": "node dist/generate-data-keys.js",
    "test": "node --env-file-if-exists=../../.env --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@school-management/server": "workspace:*",
    "@school-management/shared": "workspace:*",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@school-management/config": "workspace:*",
    "@school-management/database": "workspace:*",
    "@school-management/identity": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.12",
    "kysely": "^0.29.6"
  }
}
