{
  "name": "@school-management/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node sinh-dang-ky.mjs && tsc -p tsconfig.json",
    "typecheck": "node sinh-dang-ky.mjs && tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "generate-data-keys": "node dist/generate-data-keys.js",
    "test": "node --env-file-if-exists=../../.env --test --test-concurrency=3 \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@node-rs/argon2": "^2.2.2",
    "@school-management/database": "workspace:*",
    "@school-management/server": "workspace:*",
    "@school-management/shared": "workspace:*",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "livekit-server-sdk": "2.19.1",
    "pdfmake": "0.3.11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "2.17.0",
    "web-push": "3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@school-management/config": "workspace:*",
    "@school-management/identity": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.12",
    "@types/sanitize-html": "2.16.0",
    "@types/web-push": "3.6.4"
  }
}
