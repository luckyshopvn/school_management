{
  "name": "@school-management/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./testing": {
      "types": "./dist/test-support.d.ts",
      "default": "./dist/test-support.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "node --env-file-if-exists=../../.env --test --test-concurrency=1 \"dist/**/*.test.js\"",
    "generate-token-keys": "node dist/generate-token-keys.js",
    "create-platform-administrator": "node --env-file-if-exists=../../.env dist/create-platform-administrator.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@node-rs/argon2": "^2.2.2",
    "@school-management/database": "workspace:*",
    "@school-management/server": "workspace:*",
    "@school-management/shared": "workspace:*",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@school-management/config": "workspace:*",
    "@types/express": "^5.0.6"
  }
}
