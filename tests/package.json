{
  "name": "@school-management/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "node e2e-setup.mjs && playwright test",
