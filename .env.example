# Sao chép thành .env cho môi trường phát triển; không đưa .env lên kho mã nguồn (QU-05)
POSTGRES_PASSWORD=doi_mat_khau_quan_tri
IDENTITY_DATABASE_PASSWORD=doi_mat_khau_dinh_danh
API_DATABASE_PASSWORD=doi_mat_khau_may_chu_api

IDENTITY_DATABASE_URL=postgres://identity_service:doi_mat_khau_dinh_danh@localhost:5432/school_identity
# Cơ sở dữ liệu năm học do máy chủ API tạo khi mở năm học, cùng máy chủ và tài khoản với cơ sở dữ liệu hệ thống (QĐ-21)
SYSTEM_DATABASE_URL=postgres://api_service:doi_mat_khau_may_chu_api@localhost:5432/school_system
SCHOOL_YEAR_DATABASE_PREFIX=school_year_
REDIS_URL=redis://localhost:6379

API_PORT=3000
IDENTITY_PORT=3001
# Máy chủ API hỏi dịch vụ định danh quyền hiện hành ở địa chỉ này (QĐ-20)
IDENTITY_BASE_URL=http://localhost:3001
# Dịch vụ định danh đọc cây đơn vị qua máy chủ API khi quản lý tài khoản (YCTD-39)
API_BASE_URL=http://localhost:3000

# Khóa ký mã phiên Ed25519 (QĐ-22); sinh bằng: pnpm --filter @school-management/identity generate-token-keys
IDENTITY_TOKEN_PRIVATE_KEY=
TOKEN_PUBLIC_KEY=

# Kho tệp tương thích S3; khi phát triển là SeaweedFS trong docker compose, không kiểm tra khóa truy cập (YCTD-45)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=school-files
S3_ACCESS_KEY_ID=phat_trien
S3_SECRET_ACCESS_KEY=phat_trien

# Khóa mã hóa và khóa băm số định danh của trẻ (BM-64); sinh bằng: pnpm --filter @school-management/api generate-data-keys
CHILD_DATA_ENCRYPTION_KEY=
CHILD_DATA_HASH_KEY=

# Kết nối Fanpage và Zalo Official Account (YCTD-90, YCTD-92): development là bộ giả lập. Để trống thì chưa đăng, chưa gửi
# được. Fanpage: FACEBOOK_PUBLISHER=graph (hoặc chỉ cần có khóa) dùng khóa trang dài hạn FACEBOOK_PAGE_ACCESS_TOKEN, chỉ đặt
# ở đây; FACEBOOK_GRAPH_VERSION mặc định v21.0
FACEBOOK_PUBLISHER=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v21.0
# Zalo: ZALO_SENDER=zalo_oa bắt buộc có ZALO_APP_ID, ZALO_APP_SECRET, ZALO_OA_REFRESH_TOKEN, thiếu thì máy chủ không khởi
# động. Khóa làm mới chỉ dùng làm khóa ban đầu khi kho khóa trống; sau đó máy chủ tự làm mới và lưu khóa mới nhất, mã hóa
# bằng CHILD_DATA_ENCRYPTION_KEY, ở cơ sở dữ liệu hệ thống. ZALO_OA_ACCESS_TOKEN không bắt buộc
ZALO_SENDER=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_REFRESH_TOKEN=
ZALO_OA_ACCESS_TOKEN=

# Nhà cung cấp tin nhắn cho mã đăng nhập phụ huynh và thông báo (YCTD-92): để trống là log, chỉ ghi nhật ký khi phát
# triển; môi trường chạy thật bắt buộc SMS_PROVIDER=esms (eSMS.vn) với khóa và tên thương hiệu đã đăng ký.
# ESMS_SANDBOX=true là gửi thử, không gửi tin thật; ESMS_UNICODE=true là gửi tin có dấu (giá cao hơn)
SMS_PROVIDER=
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
ESMS_SANDBOX=
ESMS_UNICODE=

# Cổng thanh toán trực tuyến (YCTD-57, YCTD-89, YCTD-92): mã cách nhau bằng dấu phẩy, cổng đầu là mặc định. development là
# bộ giả lập, vietqr-static là VietQR tĩnh đối soát qua sao kê; payos, sepay, casso, vnpay là nhà cung cấp thật. Cổng bật mà
# thiếu biến bên dưới thì máy chủ API không khởi động. Khóa chỉ đặt ở đây, không lưu trong cơ sở dữ liệu
PAYMENT_GATEWAY=
# PayOS: khóa ở kênh thanh toán trên my.payos.vn; PAYOS_CANCEL_URL trống thì dùng PAYOS_RETURN_URL
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
# SePay: khóa của webhook kiểu xác thực API Key; SePay gửi tiêu đề Authorization: Apikey <khóa>
SEPAY_WEBHOOK_API_KEY=
# Casso: Key bảo mật của tích hợp Webhook V2
CASSO_WEBHOOK_SECRET=
# VNPay: mã website (vnp_TmnCode) và chuỗi bí mật; VNPAY_PAYMENT_URL trống thì dùng địa chỉ sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
VNPAY_PAYMENT_URL=

# Nền tảng nhiều trường (DT-SaaS phần S1a). KHÔNG đặt PLATFORM_DATABASE_URL ở bản triển khai một trường: có biến này thì dịch vụ
# định danh và máy chủ API chạy nhiều trường (nhận diện trường theo tên miền, cơ sở dữ liệu theo trường). Khóa gốc sinh bằng
# `pnpm --filter @school-management/database platform generate-master-key`; không đưa giá trị thật lên kho mã nguồn
# PLATFORM_DATABASE_URL=postgres://platform_service:doi_mat_khau@localhost:5432/school_platform
# PLATFORM_MASTER_KEY=
# Tài khoản có quyền tạo cơ sở dữ liệu và vai trò của trường (cấp nền tảng)
# PLATFORM_ADMIN_DATABASE_URL=
# Bố cục cơ sở dữ liệu của trường: database (mỗi trường các cơ sở dữ liệu riêng) hoặc schema (mỗi lược đồ riêng trong
# PLATFORM_SHARED_DATABASE, cho hồ sơ thử nghiệm)
# TENANT_DB_LAYOUT=database
# PLATFORM_SHARED_DATABASE=
# Nguồn tên miền của yêu cầu: host (mặc định), x-forwarded-host (cần TRUST_PROXY) hoặc header:<tên tiêu đề> (cần EDGE_SHARED_SECRET)
# TENANT_HOST_SOURCE=host
# EDGE_SHARED_SECRET=
# Tên miền riêng của cổng vận hành nền tảng (đăng nhập vận hành nền tảng chỉ phục vụ ở tên miền này)
# PLATFORM_CONSOLE_HOST=platform.he-thong.example
# Giới hạn nhóm kết nối: số kết nối mỗi cơ sở dữ liệu của một trường, số trường mở cùng lúc, thời gian đệm tên miền (giây)
# TENANT_POOL_MAX=3
# TENANT_POOL_SCHOOLS=20
# TENANT_CACHE_SECONDS=30
