# Sao chép thành .env cho môi trường phát triển; không đưa .env lên kho mã nguồn (QU-05)
POSTGRES_PASSWORD=doi_mat_khau_quan_tri
IDENTITY_DATABASE_PASSWORD=doi_mat_khau_dinh_danh
API_DATABASE_PASSWORD=doi_mat_khau_may_chu_api

IDENTITY_DATABASE_URL=postgres://identity_service:doi_mat_khau_dinh_danh@localhost:5432/school_identity
# Cơ sở dữ liệu năm học do máy chủ API tạo khi mở năm học, cùng máy chủ và tài khoản với cơ sở dữ liệu hệ thống (QĐ-21)
SYSTEM_DATABASE_URL=postgres://api_service:doi_mat_khau_may_chu_api@localhost:5432/school_system
SCHOOL_YEAR_DATABASE_PREFIX=school_year_
REDIS_URL=redis://localhost:6379

API_PORT=3000
IDENTITY_PORT=3001
# Máy chủ API hỏi dịch vụ định danh quyền hiện hành ở địa chỉ này (QĐ-20)
IDENTITY_BASE_URL=http://localhost:3001
# Dịch vụ định danh đọc cây đơn vị qua máy chủ API khi quản lý tài khoản (YCTD-39)
API_BASE_URL=http://localhost:3000

# Khóa ký mã phiên Ed25519 (QĐ-22); sinh bằng: pnpm --filter @school-management/identity generate-token-keys
IDENTITY_TOKEN_PRIVATE_KEY=
TOKEN_PUBLIC_KEY=

# Kho tệp tương thích S3; khi phát triển là SeaweedFS trong docker compose, không kiểm tra khóa truy cập (YCTD-45)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=school-files
S3_ACCESS_KEY_ID=phat_trien
S3_SECRET_ACCESS_KEY=phat_trien

# Khóa mã hóa và khóa băm số định danh của trẻ (BM-64); sinh bằng: pnpm --filter @school-management/api generate-data-keys
CHILD_DATA_ENCRYPTION_KEY=
CHILD_DATA_HASH_KEY=
