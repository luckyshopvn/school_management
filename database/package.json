{
  "name": "@school-management/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --env-file-if-exists=../.env dist/src/migrate-command.js",
    "test": "node --env-file-if-exists=../.env --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "kysely": "^0.29.6",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@school-management/config": "workspace:*",
    "@types/pg": "^8.23.0"
  }
}
