{
  "name": "@school-management/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "node sinh-chi-muc.mjs && tsc -p tsconfig.json",
    "typecheck": "node sinh-chi-muc.mjs && tsc -p tsconfig.json --noEmit",
    "migrate": "node --env-file-if-exists=../.env dist/src/migrate-command.js",
    "level-check": "node --env-file-if-exists=../.env dist/src/level-check-command.js",
    "test": "node --env-file-if-exists=../.env --test \"dist/**/*.test.js\"",
    "platform": "node --env-file-if-exists=../.env dist/src/platform-command.js",
    "nhieu-truong-cuc-bo": "node --env-file-if-exists=../.env dist/src/local-multi-school-command.js"
  },
  "dependencies": {
    "@school-management/server": "workspace:*",
    "kysely": "^0.29.6",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@school-management/config": "workspace:*",
    "@types/pg": "^8.23.0"
  }
}
