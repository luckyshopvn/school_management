{
  "name": "@school-management/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./timetable-solver": {
      "types": "./dist/timetable-solver.d.ts",
      "default": "./dist/timetable-solver.js"
    },
    "./timetable-generation": {
      "types": "./dist/timetable-generation.d.ts",
      "default": "./dist/timetable-generation.js"
    },
    "./resource-names": {
      "types": "./dist/resource-names.d.ts",
      "default": "./dist/resource-names.js"
    },
    "./tenant-context": {
      "types": "./dist/tenant-context.d.ts",
      "default": "./dist/tenant-context.js"
    },
    "./tenancy": {
      "types": "./dist/tenancy.d.ts",
      "default": "./dist/tenancy.js"
    },
    "./access-token": {
      "types": "./dist/access-token.d.ts",
      "default": "./dist/access-token.js"
    },
    "./external-identity": {
