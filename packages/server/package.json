  "peerDependencies": {
    "@nestjs/common": "^11.2.7"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.7",
    "@school-management/config": "workspace:*",
    "@types/express": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
